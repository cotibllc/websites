{% extends "layout/base.njk" %}

{% block content %}
<style>
  /* Hide the main header and footer for the links page */
  .site-header, .site-footer {
    display: none !important;
  }
  
  .links-page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60px 24px;
    background: var(--dark-purple);
  }
  
  .links-profile {
    text-align: center;
    margin-bottom: 40px;
  }
  .links-profile img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--gold);
    margin-bottom: 16px;
  }
  .links-profile h1 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin-bottom: 8px;
    color: var(--white);
  }
  .links-profile p {
    color: var(--off-white);
    font-size: 1.1rem;
    max-width: 400px;
    margin: 0 auto;
  }
  
  .links-container {
    width: 100%;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .link-card {
    display: block;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    text-decoration: none;
    color: var(--white);
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.3s ease;
  }
  .link-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--gold);
    transform: translateY(-2px);
  }
  .link-card--primary {
    background: var(--gold);
    color: var(--dark-purple);
    border-color: var(--gold);
  }
  .link-card--primary:hover {
    background: #e2c87b;
    color: var(--dark-purple);
  }
  
  .links-social {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin-top: 40px;
  }
  .links-social a {
    color: var(--off-white);
    transition: color 0.3s ease;
  }
  .links-social a:hover {
    color: var(--gold);
  }
  
  .links-footer {
    margin-top: auto;
    padding-top: 60px;
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.5);
  }
</style>

<div class="links-page-wrapper">
  <div class="links-profile">
    <picture>
      <source srcset="/images/photos/chuck-portrait.webp?v={{ site.assetVersion }}" type="image/webp">
      <img src="/images/photos/chuck-portrait.jpg?v={{ site.assetVersion }}" alt="Chuck Betancourt">
    </picture>
    <h1>Earned Escape</h1>
    <p>Travel Advisor • Systems Thinker<br>An affiliate of Castle Dreams Travel™</p>
  </div>

  <div class="links-container">
    <a href="/guide" class="link-card link-card--primary">
      Get the Free Guide: 5 Cruise Mistakes
    </a>
    <a href="/plan" class="link-card">
      Book a Free Planning Call
    </a>
    <a href="/royal-caribbean" class="link-card">
      Royal Caribbean Cruises
    </a>
    <a href="/disney-cruise-line" class="link-card">
      Disney Cruise Line
    </a>
    <a href="/" class="link-card">
      Visit the Website
    </a>
  </div>

  <div class="links-social">
    {% if site.social.instagram %}
      <a href="{{ site.social.instagram }}" target="_blank" aria-label="Instagram">
        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.88z"/></svg>
      </a>
    {% endif %}
    {% if site.social.facebook %}
      <a href="{{ site.social.facebook }}" target="_blank" aria-label="Facebook">
        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
      </a>
    {% endif %}
  </div>

  <div class="links-footer">
    Earned Escape is operated by {{ site.brand.business }}<br>
    and is an affiliate of {{ site.brand.parentAgency }}.
  </div>
</div>
{% endblock %}
