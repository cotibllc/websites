{% if guide %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('guide-form');
    const submitBtn = document.getElementById('guide-submit-btn');
    const successDiv = document.getElementById('guide-success');
    const errorDiv = document.getElementById('guide-error');
    if (!form) return;

    const emailOk = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorDiv.hidden = true;
      errorDiv.textContent = '';

      const email = document.getElementById('g-email').value.trim();
      const tsInput = form.querySelector('[name="cf-turnstile-response"]');
      const turnstileToken = tsInput ? tsInput.value : '';

      if (!email) {
        errorDiv.textContent = 'Please enter your email address.';
        errorDiv.hidden = false;
        return;
      }
      if (!emailOk(email)) {
        errorDiv.textContent = 'Please enter a valid email address.';
        errorDiv.hidden = false;
        return;
      }

      const originalBtnText = submitBtn.textContent;
      submitBtn.textContent = 'Sending...';
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/guide', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, turnstileToken, guideType: document.getElementById('g-guide-type').value, website: document.getElementById('g-website').value })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to submit request');
        if (data.pdfPath) document.getElementById('guide-pdf-link').href = data.pdfPath;
        form.style.display = 'none';
        successDiv.hidden = false;
      } catch (err) {
        errorDiv.textContent = err.message;
        errorDiv.hidden = false;
        submitBtn.textContent = originalBtnText;
        submitBtn.disabled = false;
      }
    });
  });
</script>
{% endif %}

{% endblock %}
