{% extends "layout/base.njk" %}

{% block content %}
  <!-- Hero / Intro -->
  <section class="plan-hero">
    <div class="plan-hero__inner">
      <p class="section-eyebrow">Free PDF Guide</p>
      <h1 class="plan-hero__headline">
        5 Mistakes First-Time<br><em>Cruisers Make</em>
      </h1>
      <p class="plan-hero__sub">
        Learn the hidden failure points that ruin family vacations, and how to pick the right ship, dining strategy, and logistics so you can actually relax.
      </p>
    </div>
  </section>

  <!-- The form -->
  <section class="plan-form" id="plan-form-section">
    <div class="plan-form__inner">
      <h2>Where should I send it?</h2>
      <p class="plan-form__lead">
        Enter your info below and I'll send the PDF directly to your inbox.
      </p>

      <div id="guide-success" class="plan-success-container" style="display:none;">
        <div class="plan-alert plan-alert--success" style="margin-bottom: 32px;">
          <strong>Thank you!</strong> Check your inbox.
        </div>
        <div class="plan-booking-cta" style="text-align: center; padding: 40px 20px; background: rgba(38, 19, 74, 0.4); border: 1px solid rgba(201, 168, 76, 0.2); border-radius: 12px; max-width: 600px; margin: 0 auto;">
          <h3 style="color: var(--white); font-family: var(--font-display); font-size: 1.8rem; margin-bottom: 12px;">Download it now</h3>
          <p style="color: var(--off-white); opacity: 0.8; margin-bottom: 28px; line-height: 1.5;">
            You don't have to wait for the email. You can download the guide directly right now:
          </p>
          <a href="/downloads/5-mistakes-first-time-cruisers-make.pdf" target="_blank" rel="noopener noreferrer" class="btn btn--gold" style="display: inline-block; padding: 14px 32px; font-weight: 600;">
            Download PDF &rarr;
          </a>
        </div>
      </div>
      <div id="guide-error" class="plan-alert plan-alert--error" style="display:none;"></div>

      <form id="guide-form" class="plan-form" novalidate>
        <div class="form-group">
          <label for="g-name">Your first name *</label>
          <input type="text" id="g-name" name="name" required autocomplete="given-name" />
        </div>

        <div class="form-group">
          <label for="g-email">Email address *</label>
          <input type="email" id="g-email" name="email" required autocomplete="email" />
        </div>

        <!-- Honeypot: hidden from real users, bots fill it and get silently dropped -->
        <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
          <label for="g-website">Website</label>
          <input type="text" id="g-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

          {% if site.turnstileSiteKey %}
          <div class="form-group">
            <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-theme="auto"></div>
          </div>
          {% endif %}

          <button type="submit" id="guide-submit-btn" class="btn btn--purple">Send Me The Guide</button>
          
          <p class="form-note">
            By requesting this guide, you'll also receive occasional travel tips from Chuck.
          </p>

          <p class="form-affiliation">
            Earned Escape is operated by {{ site.brand.business }} and is an affiliate of {{ site.brand.parentAgency }}.
          </p>
        </form>
      </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('guide-form');
      const submitBtn = document.getElementById('guide-submit-btn');
      const successDiv = document.getElementById('guide-success');
      const errorDiv = document.getElementById('guide-error');

      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        errorDiv.style.display = 'none';
        errorDiv.textContent = '';
        
        const name = document.getElementById('g-name').value;
        const email = document.getElementById('g-email').value;
        let turnstileToken = '';

        const tsInput = form.querySelector('[name="cf-turnstile-response"]');
        if (tsInput) {
          turnstileToken = tsInput.value;
        }

        if (!name || !email) {
          errorDiv.textContent = 'Please provide both your name and email address.';
          errorDiv.style.display = 'block';
          return;
        }

        const originalBtnText = submitBtn.textContent;
        submitBtn.textContent = 'Sending...';
        submitBtn.disabled = true;

        try {
          const res = await fetch('/api/guide', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, turnstileToken, website: document.getElementById('g-website').value })
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || 'Failed to submit request');
          }

          form.style.display = 'none';
          successDiv.style.display = 'block';

        } catch (err) {
          errorDiv.textContent = err.message;
          errorDiv.style.display = 'block';
          submitBtn.textContent = originalBtnText;
          submitBtn.disabled = false;
        }
      });
    });
  </script>
{% endblock %}
