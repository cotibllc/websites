<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0D0821">

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-HF5TCJ4DKH"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-HF5TCJ4DKH');
</script>

<title>{{ title or site.seo.title }}</title>
<meta name="description" content="{{ description or site.seo.description }}">

<!-- Canonical -->
<link rel="canonical" href="{{ site.siteUrl }}{{ canonical or '' }}">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title or site.seo.title }}">
<meta property="og:description" content="{{ description or site.seo.description }}">
<meta property="og:image" content="{{ site.siteUrl }}{{ ogImage or site.seo.ogImage }}">
<meta property="og:url" content="{{ site.siteUrl }}{{ canonical or '' }}">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ site.seo.twitterHandle }}">
<meta name="twitter:title" content="{{ title or site.seo.title }}">
<meta name="twitter:description" content="{{ description or site.seo.description }}">
<meta name="twitter:image" content="{{ site.siteUrl }}{{ ogImage or site.seo.ogImage }}">

<!-- Favicon -->
<link rel="icon" type="image/png" href="/images/logo/ee-favicon.png">

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Montserrat:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">

<!-- Cloudflare Turnstile (for plan/contact forms) -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<!-- Styles -->
<link rel="stylesheet" href="/css/main.bundle.css?v={{ site.assetVersion }}">

<!-- Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "Earned Escape",
  "description": "White-glove planning for elevated family vacations and luxury escapes - Royal Caribbean, Disney, and beyond. Earned Escape plans multi-generational family cruises, Disney and Universal vacations, and more exclusive bucket-list travel with a personal touch.",
  "url": "https://earnedescape.agency",
  "logo": "https://earnedescape.agency/images/logo/ee-profile-logo.png",
  "priceRange": "$$-$$$$",
  "parentOrganization": {
    "@type": "Organization",
    "name": "COTIB Adventures LLC"
  },
  "sameAs": [
    "https://instagram.com/earned_escape",
    "https://pinterest.com/earned_escape"
  ],
  "founder": {
    "@type": "Person",
    "name": "Chuck Betancourt",
    "url": "https://earnedescape.agency/about",
    "image": "https://earnedescape.agency/images/photos/chuck-betancourt-headshot-square.jpg"
  },
  "knowsAbout": [
    "Royal Caribbean cruises",
    "Disney Cruise Line",
    "Walt Disney World vacation planning",
    "Universal Orlando and Epic Universe",
    "Luxury and bucket-list travel planning",
    "Multi-generational family travel"
  ]
}
</script>

