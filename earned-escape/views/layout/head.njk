    "url": "https://earnedescape.agency"
  },
  "affiliation": {
    "@type": "Organization",
    "name": "Castle Dreams Travel",
    "url": "https://castledreamstravel.com"
  },
  "knowsAbout": [
    "Royal Caribbean cruises",
    "Disney Cruise Line",
    "Walt Disney World vacation planning",
    "Universal Orlando and Epic Universe",
    "Luxury travel planning"
  ]
}
</script>
