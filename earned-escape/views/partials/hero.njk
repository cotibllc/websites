<section class="hero" id="hero" aria-labelledby="hero-heading">
  <div class="hero__scene">
    <picture class="hero__photo">
      <source type="image/webp" srcset="/images/photos/utopia-home-1200.webp 1200w, /images/photos/utopia-home-2000.webp 2000w" sizes="100vw">
      <img src="/images/photos/utopia-home-2000.jpg" width="2000" height="1066"
        alt="Royal Caribbean's Utopia of the Seas docked in Nassau, photographed by Chuck"
        fetchpriority="high">
    </picture>
    <div class="hero__content">
      <p class="hero__eyebrow">Earned Escape</p>
      <h1 class="hero__headline" id="hero-heading">Royal Caribbean<br>Cruise Planning</h1>
      <p class="hero__answer">Earned Escape helps families plan Royal Caribbean cruises. I help you pick the right ship, cabin, and itinerary. There is no planning fee when you book your cruise through me.</p>
    </div>
    <p class="hero__caption">Utopia of the Seas in Nassau. A photo from my own trip.</p>
  </div>
  <div class="hero__intro">
    <div class="hero__intro-inner">
      <img class="hero__portrait" src="/images/photos/chuck-cruise-portrait.webp"
        alt="Chuck smiling aboard a cruise ship" width="160" height="200">
      <div class="hero__bio">
        <h2>I'm Chuck.</h2>
        <p>I help families pick the ship, route, and cabins that work for everyone.
          I also plan theme park trips and other family travel.</p>
        <p class="hero__affiliation">Chuck (Charles Betancourt), Independent Advisor, affiliate of {{ site.brand.parentAgency }}</p>
      </div>
      <div class="hero__booking">
        <a href="{{ site.links.consultation }}" class="btn btn--gold">Find the Right Ship &amp; Cabin</a>
        <p>No planning fee when you book your cruise through me.</p>
      </div>
    </div>
  </div>
</section>
