<section class="hero" id="hero">
  <canvas class="hero__starfield" id="starfield-canvas" aria-hidden="true"></canvas>

  <div class="hero__horizon-glow" aria-hidden="true"></div>
  <div class="hero__horizon-line" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__brand animate-fade-up" style="animation-delay:0.15s" aria-hidden="true">
      <img
        src="/images/logo/ee-star-lockup.png?v={{ site.assetVersion }}"
        alt="Earned Escape"
        class="hero__brand-logo"
        width="480"
        height="320"
      >
    </div>

    <p class="hero__eyebrow animate-fade-up" style="animation-delay:0.2s">
      Luxury cruises, Disney trips, and unforgettable escapes
    </p>

    <h1 class="hero__headline animate-fade-up" style="animation-delay:0.4s">
      The vacation you've been<br>
      <em>dreaming about,</em><br>
      <span class="hero__headline--outline">planned beautifully.</span>
    </h1>

    <p class="hero__sub animate-fade-up" style="animation-delay:0.6s">
      From Royal Caribbean sailings to Disney and Universal vacations,
      I help families book trips that feel effortless, elevated, and worth every minute.
    </p>

    <div class="hero__ctas animate-fade-up" style="animation-delay:0.8s">
      <a href="{{ site.links.consultation }}" class="btn btn--gold">
        Start Your Escape
      </a>
      <a href="#destinations" class="btn btn--outline">
        Explore Destinations
      </a>
    </div>
  </div>

  <div class="hero__scroll animate-fade-up" style="animation-delay:1.2s" aria-hidden="true">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-label">Explore</span>
  </div>

</section>