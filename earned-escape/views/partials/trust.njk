<section class="trust" id="why-book">
  <div class="trust__inner">
    <div class="trust__header">
      <p class="section-eyebrow">Why Travelers Book</p>
      <h2 class="trust__headline">
        Reassurance that feels<br>
        as <em>personal as the trip.</em>
      </h2>
      <p class="trust__intro">
        Booking with {{ site.brand.owner }} means working with a real advisor who knows these vacations firsthand and stays involved well beyond the first conversation.
      </p>
    </div>

    <div class="trust__grid">
      <article class="trust-card">
        <span class="trust-card__eyebrow">Personalized</span>
        <h3 class="trust-card__title">Recommendations built around your travelers</h3>
        <p class="trust-card__body">
          Every suggestion is shaped around your pace, priorities, and budget - not whatever happens to be easiest to book.
        </p>
      </article>

      <article class="trust-card">
        <span class="trust-card__eyebrow">Firsthand</span>
        <h3 class="trust-card__title">Guidance grounded in real travel experience</h3>
        <p class="trust-card__body">
          From Royal Caribbean and Disney Cruise Line to Walt Disney World and Universal, the advice comes from being there and planning for real families.
        </p>
      </article>

      <article class="trust-card">
        <span class="trust-card__eyebrow">Supported</span>
        <h3 class="trust-card__title">A real person in your corner before you go</h3>
        <p class="trust-card__body">
          You are not left to sort through details alone. You get planning support, practical answers, and someone invested in the trip going smoothly.
        </p>
      </article>
    </div>

    {% set embedded = true %}
    {% include "partials/cta-strip.njk" %}
    {% set embedded = false %}
  </div>
</section>
