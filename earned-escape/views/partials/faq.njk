{% set faqs = [
  {
    "q": "Is there a fee for using Earned Escape's travel planning service?",
    "a": "There is no planning fee when you book a cruise through Chuck. Supplier terms, fares, and any optional services are explained before you decide."
  },
  {
    "q": "What's the difference between Full-Service Planning and Advisory / Light-Touch Support?",
    "a": "Full-Service Planning means Chuck handles the research and booking coordination, then helps with staterooms, dining, and pre-trip details. If you are still deciding how much help you need, the planning call can clarify the right ship and cabin before you choose the next step."
  },
  {
    "q": "Does Earned Escape only plan family vacations?",
    "a": "Royal Caribbean is the primary focus, with Disney Cruise Line planning also available. Chuck can discuss other travel ideas during a call and will be clear about fit and scope."
  },
  {
    "q": "Which cruise lines and destinations does Earned Escape specialize in?",
    "a": "Primarily Royal Caribbean and Disney Cruise Line, with Walt Disney World and Universal Orlando planning also available."
  },
  {
    "q": "Is Earned Escape a licensed travel agency?",
    "a": "Earned Escape operates under COTIB Adventures LLC and is an affiliate of Castle Dreams Travel, giving clients the personal attention of a boutique planner backed by an established agency's industry relationships and support."
  },
  {
    "q": "How do I get started?",
    "a": "Book a free 30-minute planning call. We will identify the ship, cabin, and itinerary priorities that fit your group and agree on the next booking step."
  }
] %}

<section class="plan-faq" id="faq">
  <div class="plan-faq__header">
    <p class="section-eyebrow">Common Questions</p>
    <h2 class="plan-faq__headline">Frequently asked questions.</h2>
  </div>

  <div class="plan-faq__list">
    {% for item in faqs %}
    <div class="plan-faq__item">
      <h3 class="plan-faq__question">{{ item.q }}</h3>
      <p class="plan-faq__answer">{{ item.a }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faqs %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.a | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
