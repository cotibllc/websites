{% if not embedded %}
<section class="cta-strip" id="start-planning">
{% else %}
<div class="trust__planning" id="start-planning">
{% endif %}
  <div class="cta-strip__inner">

    <div class="cta-strip__text">
      <p class="section-eyebrow">Start Planning</p>
      <h2 class="cta-strip__headline">
        Let's design the trip<br>
        you've been <em>dreaming about.</em>
      </h2>
      <p class="cta-strip__sub">
        A 30-minute planning call to talk through your dates, priorities, and travel style — then map out the right next step.
      </p>
      <p class="cta-strip__trust">
        Earned Escape is operated by {{ site.brand.business }} and is an affiliate of {{ site.brand.parentAgency }}, pairing a personal planning experience with established travel-industry support.
      </p>
    </div>

    <div class="cta-strip__actions">
      <a href="{{ site.links.consultation }}" class="btn btn--purple">
        Reserve Your Planning Call
      </a>
      <p class="cta-strip__note">30 minutes &middot; No pressure &middot; Tailored guidance</p>
    </div>

  </div>
{% if not embedded %}
</section>
{% else %}
</div>
{% endif %}