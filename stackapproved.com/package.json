{
  "name": "stackapproved-com",
  "version": "1.0.0",
  "description": "StackApproved — UGC ads for B2B SaaS & AI brands. A COTIB LLC brand.",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./www/css/input.css -o ./www/css/tailwind.css --minify",
    "watch:css": "npx tailwindcss -i ./www/css/input.css -o ./www/css/tailwind.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"vercel dev\"",
    "build": "npm run build:css",
    "deploy": "npm run build && vercel --prod"
  },
  "dependencies": {
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.1",
    "vercel": "^50.38.2"
  },
  "engines": {
    "node": ">=18.x"
  }
}
