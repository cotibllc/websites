{
  "name": "cotib-com",
  "version": "1.0.0",
  "description": "COTIB LLC — Technology consulting and content creation. New York City.",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./www/css/input.css -o ./www/css/tailwind.css --minify",
    "watch:css": "npx tailwindcss -i ./www/css/input.css -o ./www/css/tailwind.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"vercel dev\"",
    "build": "npm run build:css",
    "deploy": "npm run build && vercel --prod",
    "test:dtnt": "node --test test/dtnt.test.js",
    "test:dtnt:preview": "node scripts/test-dtnt-preview.mjs",
    "build:dtnt": "node scripts/build-dtnt-pages.js",
    "check:syntax": "find api lib scripts \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "test": "npm run test:dtnt"
  },
  "dependencies": {
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.1",
    "vercel": "^50.38.2"
  },
  "engines": {
    "node": ">=18.x"
  }
}
